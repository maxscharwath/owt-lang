{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "types": [
      "node"
    ],
    "paths": {
      "owt": [
        "./packages/owt/src/index.ts"
      ],
      "owt/internal": [
        "./packages/owt/src/internal.ts"
      ],
      "owt/dom": [
        "./packages/owt/src/dom.ts"
      ],
      "owt/transition": [
        "./packages/owt/src/transition.ts"
      ],
      "owt/elements": [
        "./packages/owt/src/elements.ts"
      ],
      "@owt/ast": [
        "./packages/owt-ast/src/index.ts"
      ],
      "@owt/parser": [
        "./packages/owt-parser/src/index.ts"
      ],
      "@owt/compiler": [
        "./packages/owt-compiler/src/index.ts"
      ],
      "@owt/language-core": [
        "./packages/owt-language-core/src/index.ts"
      ],
      "@owt/router": [
        "./packages/owt-router/src/index.ts"
      ]
    }
  }
}

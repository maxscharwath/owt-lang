import { ArrowUpIcon, ArrowDownIcon, XIcon } from './Icon.owt'
import type { Todo } from './types'

export component TodoItem({ todo, position, first, last, onToggle, onRename, onDelete, onMoveUp, onMoveDown }: {
  todo: Todo
  position: number
  first: boolean
  last: boolean
  onToggle: () => void
  onRename: (text: string) => void
  onDelete: () => void
  onMoveUp: () => void
  onMoveDown: () => void
}) {
  var editing = false
  var draft = ''
  var input: HTMLInputElement | null = null

  function startEditing() {
    draft = todo.text
    editing = true
    queueMicrotask(() => input?.focus())
  }

  function commit() {
    if (!editing) return
    const text = draft.trim()
    if (text) onRename(text)
    editing = false
  }

  <div class="flex items-center gap-3 p-3 bg-white rounded border hover:shadow-md">
    <div class="flex items-center gap-2">
      <span class="text-sm text-gray-400 font-mono w-6 text-center">{position}.</span>
      <input
        type="checkbox"
        checked={todo.completed}
        onChange={onToggle}
        class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 focus:ring-2"
        title={todo.completed ? 'Mark as incomplete' : 'Mark as complete'}
      />
    </div>

    if (editing) {
      <input
        class="flex-1 px-2 py-1 border border-blue-300 rounded"
        ref={input}
        bind:value={draft}
        onKeyDown={(e) => {
          if (e.key === 'Enter') commit()
          if (e.key === 'Escape') editing = false
        }}
        onBlur={commit}
      />
    } else {
      <span class={['flex-1', todo.completed ? 'line-through text-gray-500' : 'text-gray-900']} onDblClick={startEditing}>
        {todo.text}
      </span>
    }

    <div class="flex gap-1">
      <button onClick={onMoveUp} disabled={first} class="icon text-blue-600 border-blue-200 hover:bg-blue-50" title="Move up">
        <ArrowUpIcon class="w-3 h-3" />
      </button>
      <button onClick={onMoveDown} disabled={last} class="icon text-blue-600 border-blue-200 hover:bg-blue-50" title="Move down">
        <ArrowDownIcon class="w-3 h-3" />
      </button>
      <button onClick={onDelete} class="icon text-red-600 border-red-200 hover:bg-red-50" title="Delete">
        <XIcon class="w-3 h-3" />
      </button>
    </div>
  </div>

  <style>
    .icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border-width: 1px;
      border-radius: 0.25rem;
    }
    .icon:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>
}

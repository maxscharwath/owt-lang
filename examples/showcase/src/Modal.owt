import { Portal } from 'owt'
import { fade, fly, scale } from 'owt/transition'

// Portal renders into document.body; <window> listens to global events.
// Transitions play when `open` changes, and the modal stays until its outro has finished.
export component Modal(open: boolean, onClose: () => void) {
  if (open) {
    <Portal>
      <div class="backdrop" onClick|self={onClose} transition:fade={{ duration: 150 }}>
        <div class="modal" role="dialog" in:fly={{ y: 24, duration: 200 }} out:scale={{ start: 0.95, duration: 150 }}>
          <slot />
          <button class="close" onClick={onClose}>Close</button>
        </div>
      </div>
    </Portal>
  }
  <window onKeyDown|escape={onClose} />

  <style>
    .backdrop {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      background: rgb(0 0 0 / 0.4);
    }
    .modal { background: white; padding: 1.5rem; border-radius: 12px; min-width: 18rem; }
    .close { margin-top: 1rem; }
  </style>
}

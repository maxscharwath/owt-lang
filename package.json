{
  "name": "owt-lang",
  "private": true,
  "version": "1.0.0-beta.1",
  "description": "OWT language: compiler, signals runtime, Vite plugin and editor tooling",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" --filter \"!owt-vscode\" build",
    "build:vscode": "pnpm --filter owt-vscode build",
    "package:vscode": "pnpm --filter owt-vscode package",
    "build:examples": "pnpm --filter \"./examples/**\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "eslint .",
    "bench": "pnpm --filter owt-benchmark bench",
    "clean": "rimraf --glob \"packages/*/dist\" \"examples/*/dist\""
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "eslint": "^10.12.0",
    "happy-dom": "^21.0.1",
    "rimraf": "^6.0.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "playwright": "^1.64.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

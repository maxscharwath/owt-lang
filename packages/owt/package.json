{
  "name": "owt",
  "version": "1.0.0-beta.1",
  "description": "OWT runtime: fine-grained signals and a compiled DOM renderer",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./dom": "./src/dom.ts",
    "./elements": "./src/elements.ts",
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json",
    "./language": {
      "types": "./src/language.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": "./dist/index.js",
      "./internal": "./dist/internal.js",
      "./dom": "./dist/dom.js",
      "./elements": "./dist/elements.js",
      "./client": {
        "types": "./client.d.ts"
      },
      "./package.json": "./package.json",
      "./language": {
        "types": "./dist/language.d.ts"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "keywords": [
    "owt",
    "signals",
    "reactive",
    "ui",
    "compiler"
  ]
}

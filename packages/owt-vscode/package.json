{
  "name": "owt-vscode",
  "displayName": "OWT",
  "description": "Language support for OWT (.owt) components: syntax highlighting, TypeScript-powered IntelliSense, diagnostics, formatting and snippets.",
  "version": "1.0.0-beta.1",
  "publisher": "owt",
  "private": true,
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#4c35de",
    "theme": "dark"
  },
  "preview": true,
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxscharwath/owt-lang.git",
    "directory": "packages/owt-vscode"
  },
  "bugs": {
    "url": "https://github.com/maxscharwath/owt-lang/issues"
  },
  "homepage": "https://github.com/maxscharwath/owt-lang/tree/main/packages/owt-vscode#readme",
  "keywords": [
    "owt",
    "component",
    "ui",
    "reactive",
    "typescript"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:owt"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces the language server only uses the TypeScript version bundled with VS Code and ignores `owt.server.path`.",
      "restrictedConfigurations": [
        "owt.server.path"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Only syntax highlighting and snippets are available in virtual workspaces."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "owt",
        "aliases": [
          "OWT",
          "owt"
        ],
        "extensions": [
          ".owt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/file-icon.svg",
          "dark": "./images/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "owt",
        "scopeName": "source.owt",
        "path": "./syntaxes/owt.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "owt",
        "path": "./snippets/owt.code-snippets"
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@owt/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true,
        "languages": [
          "owt"
        ]
      }
    ],
    "commands": [
      {
        "command": "owt.restartServer",
        "title": "Restart Language Server",
        "category": "OWT"
      },
      {
        "command": "owt.startServer",
        "title": "Start Language Server",
        "category": "OWT"
      },
      {
        "command": "owt.stopServer",
        "title": "Stop Language Server",
        "category": "OWT"
      },
      {
        "command": "owt.showOutput",
        "title": "Show Language Server Output",
        "category": "OWT"
      },
      {
        "command": "owt.showCompiledOutput",
        "title": "Show Compiled Output",
        "category": "OWT",
        "icon": "$(file-code)"
      },
      {
        "command": "owt.showVirtualCode",
        "title": "Show Virtual TypeScript Code",
        "category": "OWT"
      },
      {
        "command": "owt.selectTypeScriptVersion",
        "title": "Select TypeScript Version...",
        "category": "OWT"
      },
      {
        "command": "owt.findFileReferences",
        "title": "Find File References",
        "category": "OWT"
      },
      {
        "command": "owt.reloadProjects",
        "title": "Reload Projects",
        "category": "OWT"
      },
      {
        "command": "owt.openSettings",
        "title": "Open Settings",
        "category": "OWT"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "owt.showCompiledOutput",
          "when": "editorLangId == owt || resourceScheme == owt-compiled || resourceScheme == owt-virtual"
        },
        {
          "command": "owt.showVirtualCode",
          "when": "editorLangId == owt || resourceScheme == owt-compiled || resourceScheme == owt-virtual"
        },
        {
          "command": "owt.findFileReferences",
          "when": "editorLangId == owt && owt.serverRunning"
        },
        {
          "command": "owt.reloadProjects",
          "when": "owt.serverRunning"
        },
        {
          "command": "owt.stopServer",
          "when": "owt.serverRunning"
        },
        {
          "command": "owt.startServer",
          "when": "!owt.serverRunning"
        }
      ],
      "editor/title": [
        {
          "command": "owt.showCompiledOutput",
          "when": "resourceLangId == owt",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "owt.showCompiledOutput",
          "when": "resourceLangId == owt",
          "group": "owt@1"
        },
        {
          "command": "owt.showVirtualCode",
          "when": "resourceLangId == owt",
          "group": "owt@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "owt.findFileReferences",
          "when": "resourceLangId == owt && owt.serverRunning",
          "group": "4_search"
        }
      ],
      "explorer/context": [
        {
          "command": "owt.findFileReferences",
          "when": "resourceLangId == owt && owt.serverRunning",
          "group": "4_search"
        }
      ]
    },
    "configuration": {
      "title": "OWT",
      "properties": {
        "owt.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to a custom build of the OWT language server (the `dist/index.js` of `@owt/language-server`). Relative paths are resolved against the first workspace folder. Leave empty to use the server bundled with the extension."
        },
        "owt.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "compact",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Traces the communication between VS Code and the OWT language server in the **OWT Language Server Trace** output channel."
        },
        "owt.compiledOutput.dev": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Compile in development mode (`dev: true`) for **OWT: Show Compiled Output**."
        }
      }
    },
    "configurationDefaults": {
      "[owt]": {
        "editor.wordBasedSuggestions": "off"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies && node scripts/inject-ts-plugin.mjs",
    "test:grammar": "node scripts/test-grammar.mjs",
    "test:grammar:update": "node scripts/test-grammar.mjs --updateSnapshot"
  },
  "devDependencies": {
    "@owt/compiler": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.100.0",
    "@volar/vscode": "~2.4.28",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.9",
    "tm-grammars": "1.32.22",
    "typescript": "~6.0.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-tmgrammar-test": "^0.1.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}

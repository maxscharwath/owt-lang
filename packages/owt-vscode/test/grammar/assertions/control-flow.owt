    {
//  ^ punctuation.definition.block.owt
      <p>Closed</p>
    }
//  ^ punctuation.definition.block.owt
    val doubled = count * 2
//  ^^^ storage.type.owt
//      ^^^^^^^ variable.other.readwrite.ts
    Text with if and for (words) is not a block

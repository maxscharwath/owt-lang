  },
  "dependencies": {
    "@owt/ast": "workspace:*",
    "@owt/parser": "workspace:*",
    "@babel/types": "^7.29.8",
    "@jridgewell/gen-mapping": "^0.3.13",
    "magic-string": "^1.4.3"
  }
}
